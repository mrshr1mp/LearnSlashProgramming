{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "learn-programming",
  "mainBinaryName": "learn-programming",
  "version": "0.1.0",
  "identifier": "com.learnslashprogramming.app",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "learn/programming",
    "shortDescription": "Learn to code by building real things",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "app/**/*"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": [
          "python3"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MTQzNjcwRjFDMEFEMzgKUldRNHJjRHhjRFlVeUFCSU9vUVFXS1l3V0RuRzZobVEvT1lSWVBFeXR0UXplTkd2MXUxTkdVMG0K",
      "endpoints": [
        "https://github.com/mrshr1mp/LearnSlashProgramming/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}